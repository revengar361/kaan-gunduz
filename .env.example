# ---------------------------------------------------------------------------
# Public site origin. Used by sitemap, robots, canonicals and JSON-LD.
# MUST be set to the real domain before launch.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://kaangunduz.com

# ---------------------------------------------------------------------------
# CONTACT FORM DELIVERY
#
# Without these two, the form validates but delivers nothing:
#   - development -> logs to the terminal
#   - production  -> returns 503 and tells the visitor to use Instagram
# It never claims a message was sent when it was not.
#
# Setup (about 5 minutes):
#   1. Create a free account at https://resend.com
#   2. API Keys -> Create API Key -> paste it into RESEND_API_KEY below
#   3. Put the address where you want to receive leads in CONTACT_TO_EMAIL
#   4. To send from your own domain: Resend -> Domains -> add kaangunduz.com,
#      add the DNS records it gives you, then set CONTACT_FROM_EMAIL below.
#      Until the domain is verified, leave CONTACT_FROM_EMAIL unset — the
#      default sender works but can only deliver to your own Resend account
#      address, which is fine for testing.
# ---------------------------------------------------------------------------
CONTACT_TO_EMAIL=
RESEND_API_KEY=
# Optional. Must be on a domain verified in Resend.
#CONTACT_FROM_EMAIL="Kaan Gündüz Web Sitesi <site@kaangunduz.com>"
